# Porta que o servidor abre.
#
# O Pterodactyl e painéis parecidos entregam a porta alocada nesta variável.
# Se o painel já define ela no ambiente, o valor do painel vence este arquivo.
SERVER_PORT=25640

# Só descomente se você escolhe a porta na mão: VPS, systemd, Docker ou local.
# Quando existe, PORT tem prioridade sobre SERVER_PORT.
# PORT=3001

# Limites de admissao; nao representam capacidade garantida de midia.
GREENLABS_MAX_CONEXOES=12000
GREENLABS_MAX_POR_SALA=200

# Logs de entrada/saida apenas durante diagnostico.
# GREENLABS_DEBUG=1
